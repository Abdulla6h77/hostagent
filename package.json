{
  "name": "host-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node scripts/start.mjs",
    "lint": "eslint src tests scripts --ext .ts,.tsx,.mjs --max-warnings=0",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "validate:qloo": "node --experimental-strip-types scripts/validate-qloo.mjs",
    "validate:planner": "node scripts/validate-planner.mjs"
  },
  "dependencies": {
    "framer-motion": "^11.11.10",
    "lucide-react": "^0.454.0",
    "next": "^15.5.28",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.8.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "postcss": "$postcss",
    "postcss-selector-parser": "^7.1.7"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
